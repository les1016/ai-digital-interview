# Copy to .env and fill only on your own device.
DEEPSEEK_API_KEY=
# 在需要代理联网的电脑上填写本地 HTTP 代理；不需要时保持为空。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
JWT_SECRET=replace-with-a-long-random-local-secret
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# 留空时自动使用项目 data/ai_interview.db；不要填写依赖启动目录的相对路径。
# DATABASE_URL=
REDIS_URL=
REDIS_NAMESPACE=ai-interview
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
LIVETALKING_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DEEPSEEK_MAX_CONCURRENT=8
DEEPSEEK_QUEUE_TIMEOUT_SECONDS=5
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_USER_DAILY_CALL_LIMIT=30
DEEPSEEK_USER_DAILY_TOKEN_LIMIT=500000
DEEPSEEK_GLOBAL_DAILY_TOKEN_LIMIT=5000000
# 2026-08-10 的官方价格，单位为人民币元/百万 Token；部署前请再次核对。
DEEPSEEK_INPUT_CACHE_HIT_CNY_PER_MILLION=0.02
DEEPSEEK_INPUT_CACHE_MISS_CNY_PER_MILLION=1
DEEPSEEK_OUTPUT_CNY_PER_MILLION=2
# 0 表示开发环境不启用金额熔断；生产环境必须配置正数。
DEEPSEEK_GLOBAL_MONTHLY_BUDGET_CNY=0
ASR_INFERENCE_CONCURRENCY=1
ASR_MAX_PENDING=4
LIVETALKING_MAX_SESSIONS=2
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
VITE_API_BASE_URL=http://localhost:8000/api
VITE_LIVETALKING_URL=http://localhost:8010
MAX_USER_RECORDING_BYTES=5368709120
MAX_TOTAL_RECORDING_BYTES=21474836480
LIBREOFFICE_EXE=
ALLOW_MICROSOFT_WORD_PREVIEW=0
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=120
DOCUMENT_PREVIEW_RATE_WINDOW_SECONDS=60
DOCUMENT_PREVIEW_RATE_MAX_REQUESTS=20
DOCUMENT_PREVIEW_MAX_CONCURRENT=2
RECORDING_MAX_CONCURRENT_WRITES=4
MAX_DOCUMENT_PREVIEW_BYTES=10485760
INTERVIEW_MIN_QUESTIONS=6
INTERVIEW_MAX_QUESTIONS=12
INTERVIEW_PAUSE_MAX_SECONDS=600
MAX_CONSECUTIVE_INVALID_ANSWERS=3
# 强制退出策略：统计窗口、触发次数、冷却时长。后端口播和前端提示会自动读取这些值。
FORCED_EXIT_WINDOW_SECONDS=86400
FORCED_EXIT_THRESHOLD=3
FORCED_EXIT_COOLDOWN_SECONDS=1800
# 相同客户端、路径和状态码的 4xx 日志抑制窗口，避免恶意请求灌满事件表。
HTTP_EVENT_DEDUP_SECONDS=30
VITE_ANSWER_INITIAL_GRACE_MS=10000
VITE_ANSWER_IDLE_GRACE_MS=12000
