# Vite reads the project ROOT .env (envDir in vite.config.js), not this folder.
# Copy these optional settings to the root .env; never add service-provider keys here.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_LIVETALKING_URL=http://127.0.0.1:8010
VITE_LIVETALKING_AVATAR_ID=interviewer_realtime_v2
