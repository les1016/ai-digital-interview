APP_ENV=production
DATABASE_URL=postgresql+psycopg://ai_interview:CHANGE_ME@127.0.0.1:5432/ai_interview
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=ai-interview-production
JWT_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
DEEPSEEK_API_KEY=
DEEPSEEK_MAX_CONCURRENT=8
DEEPSEEK_QUEUE_TIMEOUT_SECONDS=5
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_USER_DAILY_CALL_LIMIT=30
DEEPSEEK_USER_DAILY_TOKEN_LIMIT=500000
DEEPSEEK_GLOBAL_DAILY_TOKEN_LIMIT=5000000
# 2026-08-10 的官方价格；上线前再次核对 DeepSeek 定价页。
DEEPSEEK_INPUT_CACHE_HIT_CNY_PER_MILLION=0.02
DEEPSEEK_INPUT_CACHE_MISS_CNY_PER_MILLION=1
DEEPSEEK_OUTPUT_CNY_PER_MILLION=2
DEEPSEEK_GLOBAL_MONTHLY_BUDGET_CNY=500
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
CORS_ALLOWED_ORIGINS=https://interview.example.com
LIVETALKING_ALLOWED_ORIGINS=https://interview.example.com
LIVETALKING_MAX_SESSIONS=2
ASR_INFERENCE_CONCURRENCY=1
ASR_MAX_PENDING=4
RECORDING_MAX_CONCURRENT_WRITES=4
TURN_URL=turn:turn.example.com:3478?transport=udp
TURN_USERNAME=CHANGE_ME
TURN_CREDENTIAL=CHANGE_ME
VITE_API_BASE_URL=/api
VITE_LIVETALKING_URL=/avatar
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
POSTGRES_DB=ai_interview
POSTGRES_USER=ai_interview
POSTGRES_PASSWORD=CHANGE_ME
