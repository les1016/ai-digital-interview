+    unrestricted = values.get("avatar_unrestricted") is True
+    identity = {"id": uid, "role": role}
+    if appointment_id is not None or appointment_until is not None:
+        if (type(appointment_id) is not int or appointment_id <= 0
+                or type(appointment_until) is not int or appointment_until <= 0
+                or preview or unrestricted):
+            raise web.HTTPUnauthorized()
+        identity.update(appointment_id=appointment_id, appointment_until=appointment_until)
+    elif preview and not unrestricted and role == "admin":
+        identity["avatar_preview"] = True
+    elif unrestricted and not preview:
+        identity["avatar_unrestricted"] = True
+    else:
+        raise web.HTTPForbidden(text="A checked-in appointment is required")
+    return identity
+
+
+def local_avatar_identity(token):
+    """Verify a two-minute avatar ticket without sharing a live SQLite DB."""
+    import os
+    from pathlib import Path
+    import jwt
+    from dotenv import dotenv_values
+    root = Path(os.environ["INTERVIEW_PROJECT_ROOT"]).resolve()
+    config = dotenv_values(root / ".env")
+    setting = lambda name, default="": os.getenv(name, config.get(name) or default)
+    if setting("APP_ENV", "development") != "development":
+        raise RuntimeError("Local avatar verification is development-only")
+    secret = setting("JWT_SECRET").strip()
+    if not secret or secret == "replace-with-a-long-random-local-secret":
+        secret = (root / "data/.jwt_secret").read_text(encoding="utf-8").strip()
+    if len(secret) < 32:
+        raise RuntimeError("Invalid local signing configuration")
+    try:
+        claims = jwt.decode(token, secret, algorithms=["HS256"], options={"require": ["exp", "sub", "iat"]})
+        if claims.get("purpose") != "avatar" or claims.get("role") not in {"student", "admin"}:
+            raise ValueError("Not an avatar ticket")
+        if claims["exp"] - claims["iat"] > 120:
+            raise ValueError("Avatar ticket lifetime exceeded")
+        return avatar_identity_scope({**claims, "id": int(claims["sub"])})
+    except (jwt.PyJWTError, ValueError, TypeError):
+        raise web.HTTPUnauthorized()
+
+
+# All model-control routes share the application's identity boundary.
+async def authenticated_avatar_user(request):
+    from aiohttp import ClientSession, ClientTimeout
+    import os
+    authorization = request.headers.get("Authorization", "")
+    if request.path == "/api/asr" and not authorization:
+        protocols = request.headers.get("Sec-WebSocket-Protocol", "").split(",")
+        token = next((p.strip()[5:] for p in protocols if p.strip().startswith("auth.")), "")
+        if token:
+            authorization = "Bearer " + token
+    if not authorization.startswith("Bearer "):
+        raise web.HTTPUnauthorized()
+    if os.getenv("INTERVIEW_AUTH_MODE") == "local-ticket":
+        try:
+            return await asyncio.to_thread(local_avatar_identity, authorization[7:])
+        except web.HTTPException:
+            raise
+        except Exception:
+            raise web.HTTPServiceUnavailable()
+    endpoint = os.getenv("INTERVIEW_AUTH_URL", "http://127.0.0.1:8000/api/avatar/identity")
+    try:
+        async with ClientSession(timeout=ClientTimeout(total=5)) as client:
+            async with client.get(endpoint, headers={"Authorization": authorization}, allow_redirects=False) as response:
+                if response.status == 401:
+                    raise web.HTTPUnauthorized()
+                if response.status == 403:
+                    raise web.HTTPForbidden()
+                if response.status == 410:
+                    raise web.HTTPGone()
+                if response.status != 200:
+                    raise web.HTTPServiceUnavailable()
+                user = await response.json()
+        if not isinstance(user, dict):
+            raise web.HTTPUnauthorized()
+        return avatar_identity_scope(user)
+    except web.HTTPException:
+        raise
+    except Exception:
+        raise web.HTTPServiceUnavailable()
+
+
+@web.middleware
+async def avatar_access_control(request, handler):
+    if request.path == "/healthz" or request.method == "OPTIONS":
+        return await handler(request)
+    user = await authenticated_avatar_user(request)
+    deadline = user.get("appointment_until")
+    if deadline is not None and time.time() >= deadline and request.path != "/api/session/close":
+        raise web.HTTPGone(text="The interview window has ended")
+    request["avatar_identity"] = user
+    admin = user["role"] == "admin" and (
+        user.get("avatar_preview") or user.get("avatar_unrestricted")
+    )
+    controls = {"/human", "/is_speaking", "/interrupt_talk", "/api/session/close"}
+    public_routes = controls | {"/offer", "/api/asr"}
+    if not admin and request.path not in public_routes:
+        raise web.HTTPForbidden()
+    if request.path in controls or request.path == "/offer":
+        if request.method != "POST":
+            raise web.HTTPMethodNotAllowed(request.method, ["POST"])
+        try:
+            params = await request.json()
+            if not isinstance(params, dict):
+                raise ValueError()
+        except Exception:
+            raise web.HTTPBadRequest()
+        if not admin and request.path == "/offer" and set(params) - {"sdp", "type"}:
+            raise web.HTTPForbidden()
+        if not admin and request.path == "/human" and params.get("type") != "echo":
+            raise web.HTTPForbidden()
+        if request.path in controls:
+            session = get_session(request, str(params.get("sessionid", "")))
+            if session is None:
+                raise web.HTTPNotFound()
+            if not admin and (
+                getattr(session, "interview_owner_id", None) != user["id"]
+                or getattr(session, "appointment_id", None) != user.get("appointment_id")
+            ):
+                raise web.HTTPForbidden()
+        if deadline is not None and time.time() >= deadline and request.path != "/api/session/close":
+            raise web.HTTPGone(text="The interview window has ended")
+    response = await handler(request)
+    if request.path == "/offer" and response.status == 200:
+        payload = json.loads(response.text)
+        if payload.get("sessionid"):
+            session = get_session(request, str(payload["sessionid"]))
+            if session is not None:
+                session.interview_owner_id = user["id"]
+                session.appointment_id = user.get("appointment_id")
+    return response
+
