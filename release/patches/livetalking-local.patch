@@ -69,6 +69,31 @@ def load_model(path):
     model = model.to(device)
     return model.eval()
 
+def blend_wav2lip_lower_face(base_roi, generated_roi, preserve_upper_face=False):
+    """Blend Wav2Lip only where speech motion is needed.
+
+    Expression-test avatars keep the original upper face pixel-stable so eye
+    blinks are never regenerated into a blurry iris by Wav2Lip. The vertical
+    and side feathering also removes the rectangular paste boundary.
+    """
+    if not preserve_upper_face:
+        return generated_roi
+    height, width = base_roi.shape[:2]
+    vertical = np.linspace(0.0, 1.0, height, dtype=np.float32)
+    vertical = np.clip((vertical - 0.46) / 0.20, 0.0, 1.0)
+    vertical = vertical * vertical * (3.0 - 2.0 * vertical)
+    edge = max(4, min(12, width // 12))
+    horizontal = np.ones(width, dtype=np.float32)
+    horizontal[:edge] = np.linspace(0.0, 1.0, edge, dtype=np.float32)
+    horizontal[-edge:] = np.linspace(1.0, 0.0, edge, dtype=np.float32)
+    alpha = (vertical[:, None] * horizontal[None, :])[..., None]
+    return np.clip(
+        base_roi.astype(np.float32) * (1.0 - alpha)
+        + generated_roi.astype(np.float32) * alpha,
+        0,
+        255,
+    ).astype(np.uint8)
+
